#include "LEDMatrix.h"

#define LED_PIN 6

LEDMatrix matrix(LED_PIN);

void setup() {
    matrix.begin(20);
}

void loop() {
    matrix.clear();

    matrix.pixel(10, 10, YELLOW);
    matrix.pixel(10, 11, YELLOW);
    matrix.pixel(10, 12, YELLOW);
    matrix.pixel(10, 13, YELLOW);
    matrix.pixel(10, 14, YELLOW);
    matrix.pixel(10, 15, YELLOW);

    matrix.pixel(11, 13, YELLOW);
    matrix.pixel(12, 13, YELLOW);

    matrix.pixel(13, 10, YELLOW);
    matrix.pixel(13, 11, YELLOW);
    matrix.pixel(13, 12, YELLOW);
    matrix.pixel(13, 13, YELLOW);
    matrix.pixel(13, 14, YELLOW);
    matrix.pixel(13, 15, YELLOW);

    matrix.pixel(15, 10, YELLOW);
    matrix.pixel(15, 11, YELLOW);
    matrix.pixel(15, 12, YELLOW);
    matrix.pixel(15, 13, YELLOW);
    matrix.pixel(15, 14, YELLOW);
    matrix.pixel(15, 15, YELLOW);



    matrix.show();
}
